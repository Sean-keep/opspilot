# OpsPilot configuration template.
#
# Copy to `.env` (which is gitignored) and fill in real values.
# NEVER commit a filled-in copy. NEVER put real secrets in this file.
#
# Values marked [file] may also be supplied by pointing at a permission-restricted
# file (see the *_FILE variants). That is how the master encryption key is injected
# so the key is never stored next to the ciphertext it protects.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# dev | staging | production
OPSPILOT_ENV=dev

# Bind address for the API. Keep on loopback unless a reverse proxy fronts it.
OPSPILOT_API_HOST=127.0.0.1
OPSPILOT_API_PORT=8080

# Log level: DEBUG | INFO | WARNING | ERROR
OPSPILOT_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# MySQL (control-plane metadata only — never managed business data)
# ---------------------------------------------------------------------------
OPSPILOT_DB_HOST=127.0.0.1
OPSPILOT_DB_PORT=3306
OPSPILOT_DB_NAME=opspilot
OPSPILOT_DB_USER=opspilot
OPSPILOT_DB_PASSWORD=

# Test database. Distinct from OPSPILOT_DB_NAME; tests wipe it.
OPSPILOT_TEST_DB_NAME=opspilot_test

# ---------------------------------------------------------------------------
# Auth / sessions
# ---------------------------------------------------------------------------
# Sign JWTs and session cookies. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
OPSPILOT_SECRET_KEY=

# Access token lifetime, seconds.
OPSPILOT_ACCESS_TOKEN_TTL=3600

# Login rate limiting: failed attempts allowed per window, and window length.
OPSPILOT_LOGIN_MAX_FAILURES=10
OPSPILOT_LOGIN_WINDOW_SECONDS=300

# ---------------------------------------------------------------------------
# Credential encryption
# ---------------------------------------------------------------------------
# Master key for encrypting stored credential payloads (Fernet, urlsafe base64
# 32 bytes). Generate with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# Supply EITHER OPSPILOT_MASTER_KEY or OPSPILOT_MASTER_KEY_FILE.
# The key MUST NOT be stored in the same place as the ciphertext it protects.
OPSPILOT_MASTER_KEY=
# OPSPILOT_MASTER_KEY_FILE=/etc/opspilot/master.key

# ---------------------------------------------------------------------------
# Worker
# ---------------------------------------------------------------------------
# Unique per worker process; used as ops_task_runs.lease_owner.
OPSPILOT_WORKER_ID=

# How long a claimed run stays leased before another worker may recover it.
OPSPILOT_LEASE_SECONDS=30

# Heartbeat interval; must be well under OPSPILOT_LEASE_SECONDS.
OPSPILOT_HEARTBEAT_SECONDS=5

# Max runs one worker will execute concurrently.
OPSPILOT_WORKER_CONCURRENCY=2

# ---------------------------------------------------------------------------
# Remote execution (SSH)
# ---------------------------------------------------------------------------
# Default remote user. Never root — see README "Least privilege".
OPSPILOT_SSH_USER=

# TCP connect / command / health-check timeouts, seconds.
OPSPILOT_SSH_CONNECT_TIMEOUT=10
OPSPILOT_SSH_COMMAND_TIMEOUT=600
OPSPILOT_HEALTHCHECK_TIMEOUT=30

# ---------------------------------------------------------------------------
# Artifact / URL allowlists (SSRF and supply-chain guard)
# ---------------------------------------------------------------------------
# Comma-separated hostnames that release fetching may contact.
# Unauthorised intranet ranges and cloud metadata addresses are always denied.
OPSPILOT_ARTIFACT_ALLOWED_HOSTS=

# Comma-separated CIDRs that HTTP health checks may target.
# Loopback is denied by default for health checks against external services.
OPSPILOT_HEALTHCHECK_ALLOWED_CIDRS=127.0.0.0/8

# ---------------------------------------------------------------------------
# Retention
# ---------------------------------------------------------------------------
# Task log retention, days. Older chunks are archived then deleted.
OPSPILOT_LOG_RETENTION_DAYS=30

# Max bytes of log kept per task run before truncation is enforced.
OPSPILOT_LOG_MAX_BYTES_PER_RUN=10485760

# ---------------------------------------------------------------------------
# Notifications (optional in S0-S4)
# ---------------------------------------------------------------------------
OPSPILOT_TELEGRAM_BOT_TOKEN=
OPSPILOT_TELEGRAM_CHAT_ID=
