{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "python312 inputs",
  "type": "object",
  "additionalProperties": false,
  "required": ["app_user", "app_root"],
  "properties": {
    "app_user": {
      "type": "string",
      "pattern": "^[a-z_][a-z0-9_-]{0,31}$",
      "default": "opspilot-app",
      "description": "System account the application runs as. Created if missing."
    },
    "app_root": {
      "type": "string",
      "pattern": "^/opt/opspilot/apps/[a-z0-9][a-z0-9_-]{0,31}$",
      "default": "/opt/opspilot/apps/demo",
      "description": "Root of the application's release, shared, and current directories."
    },
    "python_version": {
      "type": "string",
      "enum": ["3.11", "3.12"],
      "default": "3.12",
      "description": "Interpreter version to provision."
    }
  }
}
